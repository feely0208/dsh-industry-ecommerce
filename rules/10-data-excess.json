{
  "id": "ECO-DATA-EXCESS",
  "title": "订单环节收集与交易无关的身份证等敏感信息",
  "severity": "medium",
  "source": "《个人信息保护法》第6条 —— 收集个人信息应当限于实现处理目的的最小范围；跨境电商清关等法定场景除外",
  "advice": "普通订单不需要身份证号；确需收集的（跨境清关）应单独说明目的并加密存储。命中处确认收集必要性。",
  "check": {
    "type": "file-pattern",
    "pattern": "订单[^\\n]{0,24}身份证|身份证[^\\n]{0,24}订单|下单[^\\n]{0,24}实名\\d",
    "flags": "gi",
    "exts": [".md", ".txt", ".js", ".ts", ".py", ".json", ".yaml", ".yml", ".sql"],
    "when": "(?:订单|下单|checkout|order)",
    "max": 20
  }
}
